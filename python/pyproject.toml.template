[project]
name = "PLACEHOLDER_NAME"
version = "0.1.0"
description = "PLACEHOLDER_DESCRIPTION"
readme = "README.md"
requires-python = ">=3.13"
dependencies = []

[dependency-groups]
dev = [
    "pre-commit>=4.5.1",
    "pyright>=1.1.400",
    "pytest>=8.0",
    "ruff>=0.16.5",
]

# 配布パッケージとしてビルドする場合のみ有効化する (uv_build は src/<パッケージ名>/ レイアウトを要求する)
# 非パッケージ (解析・スクリプト等) では build-system を定義しないこと (uv が仮想プロジェクトとして扱う)
# [build-system]
# requires = ["uv_build>=0.9.11,<0.10.0"]
# build-backend = "uv_build"

[tool.pytest.ini_options]
testpaths = ["tests"]

# pyright は設定ファイルからの相対パスで include/exclude を解決するため、
# .config/ へ切り出さず pyproject.toml へ置く
[tool.pyright]
typeCheckingMode = "strict"
