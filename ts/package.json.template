{
    "name": "PLACEHOLDER_NAME",
    "version": "0.0.1",
    "private": true,
    "description": "PLACEHOLDER_DESCRIPTION",
    "scripts": {
        "dev": "PLACEHOLDER_DEV_COMMAND",
        "build": "PLACEHOLDER_BUILD_COMMAND",
        "lint": "eslint . && markdownlint-cli2 --config .config/.markdownlint.jsonc \"**/*.md\" \"#node_modules\"",
        "format": "prettier --config .config/.prettierrc --ignore-path .config/.prettierignore --write \"**/*.{ts,tsx,json,md}\" && eslint --fix .",
