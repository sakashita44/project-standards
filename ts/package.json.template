        "lint-staged": "^15.5.2",
        "markdownlint-cli2": "^0.20.0",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vitest": "^4.0.18"
    }
}
