# mise の設定をこのホストだけで上書きする任意の設定例。
# 必要な節だけを mise.local.toml へコピーして書き換える。
# mise.local.toml はホスト固有の値を持つため Git 管理外とする。

# ホスト固有の外部ツールの場所を差し替える。
# mise が版を管理しない CLI（CAD、vendor SDK など）について、このプロジェクトだけ
# 別の実体を使う必要がある場合に使う。
[env]
_.path = 'C:\path\to\tool\bin'

# プロジェクトの mise.toml が宣言したツールを、このホストでは使わない。
# ホストへ別途導入したものを mise のプラグインで扱うツールなど、このホストの mise で
# 解決できないツールがあると、mise はコマンド実行のたびに警告を出し、mise install も失敗する。
# 該当するツール名を列挙すると、mise はそのツールを無視する。
# [settings]
# disable_tools = ['tool-name']
